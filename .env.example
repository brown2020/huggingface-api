# Server-only secrets — never commit real values; never inline in CI YAML.
HF_TOKEN=your_huggingface_token_here
REPLICATE_API_TOKEN=your_replicate_token_here
# Optional pinned LLaVA version (otherwise resolved via Replicate API)
# REPLICATE_LLAVA_13B_VERSION=

# Off by default, so a configured server tries Hugging Face first.
# Set to true to force saved samples and skip live providers.
# HF_USE_FIXTURES=true

# When set, POST /api/hf requires this value in `x-hf-api-key` or `Authorization: Bearer`.
# When unset, live provider calls are refused and fixture mode still works.
# Server-only — never NEXT_PUBLIC_*. Paste it into the Demo password field; do not bundle it.
# HF_API_SECRET=
